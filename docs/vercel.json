{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "sh -c 'base=${VERCEL_GIT_PREVIOUS_SHA:-HEAD~1}; git cat-file -e \"$base\" 2>/dev/null || exit 1; git diff --quiet \"$base\" HEAD -- . package.json bun.lock package-lock.json vercel.json'",
  "framework": "vitepress",
  "buildCommand": "bun run docs:build",
  "installCommand": "bun install",
  "outputDirectory": ".vitepress/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "max-age=31536000, immutable" }
      ]
    }
  ]
}
